                  "name": "Texto",
                  "fill": "$pl-tinta",
                  "content": "6 · TOCA EL TOKEN DE LA CRIATURA EN EL MAPA Y ATACA CON ELLA",
                  "fontFamily": "$font-plenilunio",
                  "fontSize": 9.5,
                  "fontWeight": "500",
