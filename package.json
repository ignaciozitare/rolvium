{
  "name": "rolvium",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm -w apps/web run dev",
    "dev:api": "npm -w apps/api run dev",
    "build": "npm -w apps/web run build",
    "build:web": "npm -w apps/web run build",
    "build:api": "npm -w apps/api run build",
    "typecheck": "npm -w apps/web run typecheck && npm -w apps/api run typecheck",
    "test": "npm -w apps/web run test && npm -w apps/api run test && npm -w packages/core run test && npm -w packages/ui run test && npm -w packages/system-plenilunio run test",
    "test:smoke": "npm -w apps/web run test:smoke",
    "test:regression": "npm -w apps/web run test:regression && npm -w apps/api run test",
    "test:functional": "npm -w apps/web run test:functional",
    "audit": "node scripts/audit.mjs",
    "ui:catalog": "node scripts/gen-ui-catalog.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:migration": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/shared-types/src/database.types.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
